#!/bin/bash
# Start an OpenCode lead in a herdr workspace, in a new visible tab.
# Usage: start-opencode-lead.sh <workspace-id> <project-dir> [handover-file]
# Example: start-opencode-lead.sh w2 ~/Projects/my-app ~/.herdr-agent/handover/w2-handover.md
set -euo pipefail
WS=${1:?workspace id, e.g. wB}; DIR=${2:?project folder}; HO=${3:-}
DIR=$(cd "$DIR" && pwd)
mkdir -p "$HOME/.herdr-agent/handover"
[ -z "$HO" ] && HO=$(ls -t "$HOME/.herdr-agent/handover/$WS"-*.md 2>/dev/null | grep -v opencode-notes | head -1 || true)
PROMPT="You are the LEAD of herdr workspace $WS. Claude is not available, so you replace the user's Claude lead. First use the skill tool to load the skill opencode-lead and read it fully, then follow its section 1 step by step. Project folder: $DIR."
[ -n "$HO" ] && PROMPT="$PROMPT Handover file from the previous lead: $HO - read it fully; it is your task list."
P=$(herdr tab create --workspace "$WS" --cwd "$DIR" --label "oc-lead" | grep -oE '"pane_id":"[^"]*"' | head -1 | cut -d'"' -f4)
[ -n "$P" ] || { echo "could not create a tab in $WS" >&2; exit 1; }
printf '%s' "$PROMPT" > "$HOME/.herdr-agent/handover/$WS-opencode-start.txt"
herdr pane send-text "$P" "cd \"$DIR\" && opencode --auto --prompt \"\$(cat ~/.herdr-agent/handover/$WS-opencode-start.txt)\"
"
echo "OpenCode lead starting in $WS, pane $P${HO:+, handover $HO}"
